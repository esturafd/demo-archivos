# Configuración del ambiente local (compose.yml). Copia este archivo como `.env`
# en la raíz del proyecto para cambiar los valores por defecto.
#
# Todos los valores son de pruebas; no son secretos.

# Puertos publicados en la máquina.
FRONTEND_PORT=8081
BACKEND_PORT=8080
DB_PORT=5432
S3_PORT=9090

# Base de datos.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
APP_MIGRATOR_PASSWORD=migrator
APP_RUNTIME_PASSWORD=runtime

# Credenciales que el cliente S3 envía a s3mock (s3mock no las valida).
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Clave del HMAC que indexa los intentos de inicio de sesión.
APP_AUTH_RATE_LIMIT_KEY=clave-local-de-pruebas
