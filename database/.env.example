# Ejemplo de configuración para database/provision-environment.sh
#
# Copia este archivo como .env, junto al script, y completa los valores reales.
# El archivo .env NO debe versionarse (.gitignore ya lo excluye).
#
# Consejo: si un valor contiene caracteres especiales (#, $, espacios), enciérralo
# entre comillas simples.

# -----------------------------------------------------------------------------
# Conexión administrativa
# -----------------------------------------------------------------------------
# Rol propietario/administrador de la base (por ejemplo neondb_owner).
# Usa el endpoint directo de Neon, sin el sufijo "-pooler", para tareas de
# aprovisionamiento.
#
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require

ADMIN_DATABASE_URL='postgresql://neondb_owner:contraseña_del_propietario@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require'

# Alternativa a ADMIN_DATABASE_URL: si se deja vacía, el script usará estas
# variables del entorno. Descomenta y define si prefieres este modo.
# PGHOST=ep-ejemplo-123456.us-east-2.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=contraseña_del_propietario
# PGSSLMODE=require

# -----------------------------------------------------------------------------
# Contraseñas de los roles técnicos
# -----------------------------------------------------------------------------
# Genera valores largos y aleatorios. Ejemplo:
#   openssl rand -base64 32
#
# APP_MIGRATOR_PASSWORD la usa Flyway desde CI/CD (rol app_migrator).
# APP_RUNTIME_PASSWORD la usa la API Quarkus (rol app_runtime).

APP_MIGRATOR_PASSWORD='cambia-esta-contraseña-de-migracion'
APP_RUNTIME_PASSWORD='cambia-esta-contraseña-de-runtime'
