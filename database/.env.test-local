# Credenciales del ambiente local de pruebas.
#
# Las usa database/test-database.sh para levantar un PostgreSQL desechable y
# dejarlo listo para pruebas locales.
#
# Son valores ficticios y públicos: el ambiente es local, efímero y no contiene
# datos reales. NO reutilices estas credenciales en CI, staging ni producción;
# en esos ambientes las credenciales provienen de secretos.
#
# Para usar otro archivo de configuración:
#   ENV_FILE=/ruta/a/mi.env ./test-database.sh

# --- Base de datos ---
DB_NAME=neondb
DB_OWNER=neondb_owner
DB_OWNER_PASSWORD=local_owner_password

# Puerto publicado en el host para conectarse con un cliente local.
HOST_PORT=55432

# --- Roles técnicos creados por provision-environment.sh ---
# app_migrator: ejecuta Flyway y es propietario de los esquemas app y audit.
# app_runtime : conexión de la API; nunca puede omitir RLS.
APP_MIGRATOR_PASSWORD=local_migrator_password
APP_RUNTIME_PASSWORD=local_runtime_password

# --- Imágenes (opcional) ---
# Conviene fijar versiones concretas para que el ambiente sea reproducible.
# PG_IMAGE=postgres:16-alpine
# FLYWAY_IMAGE=flyway/flyway:latest
