# Configuración del ambiente productivo del backend.
#
# Copia este archivo como `.env.deploy` en esta misma carpeta, completa los
# valores reales y ejecuta `./configure-environment.sh` (una sola vez, a mano,
# antes de montar el CI/CD).
#
# `.env.deploy` está ignorado por git: nunca se versiona.
#
# Se llama `.env.deploy` y no `.env` a propósito: Quarkus lee un archivo `.env`
# en el directorio de trabajo durante el desarrollo y las pruebas, y eso haría
# que las pruebas usaran la base de datos y el almacenamiento reales. Con este
# nombre, Quarkus no lo toca.
#
# Leyenda:
#   [SECRETO]  -> el script lo sube a Secret Manager.
#   (sin marca)-> variable no secreta; se configura en Cloud Run como entorno.

# -----------------------------------------------------------------------------
# Google Cloud · recursos del ambiente (se crean una sola vez)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=archivos-demo
GCP_REGION=us-central1
GCP_SERVICE=archivos-backend
GCP_ARTIFACT_REPO=archivos
GCP_SA_DEPLOY=github-deploy
GCP_SA_RUNTIME=archivos-runtime

# Repositorio de GitHub (owner/repo) autorizado a desplegar (Workload Identity).
GITHUB_REPO=usuario/repositorio
WIF_POOL=github
WIF_PROVIDER=github-provider

# -----------------------------------------------------------------------------
# Base de datos (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# URL JDBC del *pooler* de Neon, sin credenciales, con el usuario de ejecución.
QUARKUS_DATASOURCE_JDBC_URL='jdbc:postgresql://ep-ejemplo-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require'
QUARKUS_DATASOURCE_USERNAME=app_runtime

# [SECRETO] Contraseña de app_runtime (la fija database/provision_environment.py).
QUARKUS_DATASOURCE_PASSWORD='cambia-esta-contraseña'

# Rol al que la API cambia en cada transacción (RLS). Lo fija el esquema.
APP_DATABASE_RUNTIME_ROLE=app_runtime

# -----------------------------------------------------------------------------
# Almacenamiento de objetos (bucket de Neon, compatible con S3)
# -----------------------------------------------------------------------------
APP_STORAGE_BUCKET=files
QUARKUS_S3_AWS_CREDENTIALS_TYPE=static
QUARKUS_S3_ENDPOINT_OVERRIDE='https://endpoint-del-bucket.example'
QUARKUS_S3_AWS_REGION=us-east-1
QUARKUS_S3_AWS_CREDENTIALS_STATIC_PROVIDER_ACCESS_KEY_ID='identificador-de-acceso'

# [SECRETO] Clave secreta del bucket.
QUARKUS_S3_AWS_CREDENTIALS_STATIC_PROVIDER_SECRET_ACCESS_KEY='clave-secreta-del-bucket'

# -----------------------------------------------------------------------------
# Autenticación
# -----------------------------------------------------------------------------
# [SECRETO] Clave HMAC con la que se indexan los intentos de inicio de sesión.
# Genera una con:  openssl rand -base64 32
APP_AUTH_RATE_LIMIT_KEY='clave-aleatoria-larga'
